<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="safe/" />
        <exclude domain="file" path="datastore/safe_folder.preferences_pb" />
        <exclude domain="sharedpref" path="safe_folder_keyset.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="safe/" />
        <exclude domain="file" path="datastore/safe_folder.preferences_pb" />
        <exclude domain="sharedpref" path="safe_folder_keyset.xml" />
    </device-transfer>
</data-extraction-rules>
